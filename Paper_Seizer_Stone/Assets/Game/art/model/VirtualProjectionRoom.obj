# Timber Cabin matched room shell for the saved BasicBattle scene.
# All scene, prefab, projection and camera transforms remain unchanged.
# Unity local floor Y=-3; player-side Z=-22. The player side stays open.
# Five planar surfaces share corner vertices to avoid diagonal fold seams.
# OBJ coordinates mirror X and reverse triangles for the Unity OBJ importer.
# Calibration uses FOV=26, source rect=(0.18,0.12,0.625,0.625), aspect=2.
# Timber Cabin pixels (1774x887, top-left): rear LB=(460,503), RB=(1330,507),
# LT=(447,145), RT=(1338,145); side floor anchors=(212,571)/(1532,569).
o VirtualProjectionRoom
g VirtualProjectionRoom
v 17.283779 -3.000000 -22.000000
v -17.627528 -3.000000 -22.000000
v -7.981891 -3.000000 -1.346139
v 5.811968 -3.000000 -0.998807
v 15.307814 35.584687 -22.000000
v -15.327067 34.860156 -22.000000
v -7.093597 11.447314 -1.323772
v 5.085281 11.385206 -1.017105
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0.000000 1.000000 0.000000
vn 0.025172 0.000000 -0.999683
vn -0.876719 -0.044898 -0.478904
vn 0.904693 -0.054971 -0.422504
vn 0.015580 -0.658778 -0.752176
s off
# Floor, inward-facing.
f 1/1/1 3/3/1 4/2/1
f 1/1/1 2/4/1 3/3/1
# Back wall, inward-facing.
f 4/1/2 7/3/2 8/2/2
f 4/1/2 3/4/2 7/3/2
# Left wall, inward-facing.
f 1/1/3 8/3/3 5/2/3
f 1/1/3 4/4/3 8/3/3
# Right wall, inward-facing.
f 2/1/4 7/3/4 3/2/4
f 2/1/4 6/4/4 7/3/4
# Ceiling, inward-facing.
f 5/1/5 7/3/5 6/2/5
f 5/1/5 8/4/5 7/3/5
