# Projection-matched room shell for the saved BasicBattle scene.
# All scene, prefab, projection and camera transforms remain unchanged.
# Unity local floor Y=-3; player-side Z=-22. The player side stays open.
# Five planar surfaces share corner vertices to avoid diagonal fold seams.
# OBJ coordinates mirror X and reverse triangles for the Unity OBJ importer.
# Calibration uses FOV=26, source rect=(0.18,0.14,0.625,0.625), aspect=2.
# Source pixels (top-left): rear LB=(425,507), RB=(1250,504),
# LT=(418,128), RT=(1264,130); floor sides=(0,662)/(1672,668).
o VirtualProjectionRoom
g VirtualProjectionRoom
v 15.455453 -3.000000 -22.000000
v -16.629768 -3.000000 -22.000000
v -8.083840 -3.000000 -0.094720
v 6.034486 -3.000000 -0.348721
v 13.559750 30.586218 -22.000000
v -14.781140 30.786321 -22.000000
v -7.303176 11.367896 -0.108765
v 5.210818 11.478703 -0.333902
vt 0 0
vt 1 0
vt 1 1
vt 0 1
vn 0.000000 1.000000 0.000000
vn -0.017988 0.000000 -0.999838
vn -0.915730 -0.051686 -0.398455
vn 0.930405 -0.050907 -0.362980
vn -0.005288 -0.748981 -0.662570
s off
# Floor, inward-facing.
f 1/1/1 3/3/1 4/2/1
f 1/1/1 2/4/1 3/3/1
# Back wall, inward-facing.
f 4/1/2 7/3/2 8/2/2
f 4/1/2 3/4/2 7/3/2
# Left wall, inward-facing.
f 1/1/3 8/3/3 5/2/3
f 1/1/3 4/4/3 8/3/3
# Right wall, inward-facing.
f 2/1/4 7/3/4 3/2/4
f 2/1/4 6/4/4 7/3/4
# Ceiling, inward-facing.
f 5/1/5 7/3/5 6/2/5
f 5/1/5 8/4/5 7/3/5
