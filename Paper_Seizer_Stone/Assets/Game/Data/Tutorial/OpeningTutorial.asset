  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0f72f3a381845ee389e10c8d9b1dc54b, type: 3}
  m_Name: OpeningTutorial
  m_EditorClassIdentifier:
  sequences:
  - node: 0
    lines:
    - text: "醒了？欢迎来到牌桌。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    openManual: 0
    page: 0
  - node: 1
    lines:
    - text: "先抽四张牌。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    openManual: 0
    page: 0
  - node: 2
    lines:
    - text: "我可以允许你再抽一张。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    openManual: 0
    page: 0
  - node: 3
    lines:
    - text: "选好四张，摆到台上去。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    openManual: 0
    page: 0
  - node: 4
    lines:
    - text: "摆好了就按铃。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    openManual: 0
    page: 0
  - node: 5
    lines:
    - text: "你这就打算开牌了？"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    - text: "别急，我们赌点<shake>更有意思的</shake>。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    openManual: 1
    page: 1
  - node: 6
    lines:
    - text: "你还活着啊。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    - text: "<shake>再挨一枪</shake>，你就真完蛋了。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    openManual: 1
    page: 2
  - node: 7
    lines:
    - text: "<shake a=0.5>呃，好吧。</shake>"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.3
    openManual: 0
    page: 0
  - node: 8
    lines: []
    openManual: 1
    page: 3
  - node: 9
    lines: []
    openManual: 1
    page: 4
  - node: 10
    lines: []
    openManual: 1
    page: 0
  - node: 11
    lines:
    - text: "啧，你运气真够好的。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    - text: "来认真赌一局吧。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    - text: "我还是会给你第二次机会。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    - text: "当然，我也会给我自己第二次机会。"
      voice: {fileID: 0}
      characterSeconds: 0.055
      holdSeconds: 1.6
    openManual: 0
    page: 0
  pages:
  - page: 0
    title: "基础对抗"
    body: "从手里选出四张牌，拖到面前的四个位置。\n每张牌只与正对面的牌比拼。\n胜利得2分，失败不得分，平局各获得1分。\n按下铜铃后结束回合。"
  - page: 1
    title: "作弊与代价"
    body: "每个回合，会揭开双方的一张牌。如果翻牌后场上还有未翻开的牌，你和对手各有一次作弊机会。\n作弊：\n• 交换自己场上两张牌的位置，或用手牌换下场上牌：给对手装入 1 发子弹。\n• 点击自己的牌库，多抽一张牌：给对手装入 2 发子弹。\n• 不想作弊：按铜铃，或按回车 / 空格跳过。\n双方的枪最多装 6 发子弹，若装满则不能作弊。\n若这回合没赢过他，这些子弹就可能打向你。"
  - page: 2
    title: "生命与射击"
    body: "总分高的一方向对手开一枪；同分时，双方都不开枪，直接结束本回合。\n左轮最多装 6 发子弹，装得越多，中弹机会越大。\n在一场战斗中首次中弹时，你可以幸免遇难。但如果在同一场战斗中中弹两次，你就完蛋了！"
  - page: 3
    title: "商店与整备"
    body: "注意到桌上的筹码了吗？每次对战前，会加注8枚筹码，每经过一个回合，就会失去一枚。\n赢下对局，桌上剩余的筹码全部归你，为了更多的钱，尽快结束战斗！\n你可以在商店随意消费，购买高级卡牌，删除卡牌，以及……一些其它的功能？"
  - page: 4
    title: "刻印与标签"
    body: "从现在起，商店开始提供刻印服务。\n每家商店随机提供一种刻印，将鼠标移到刻印台上可以查看名称和费用。\n刻印会改变一张牌的结算方式，使其可能产生新的分值结果。"
  speechBlips:
  - {fileID: 8300000, guid: 5c757efcc7e75124969839e2eba406f1, type: 3}
  - {fileID: 8300000, guid: dae937b9c13f5a5aafae689b68fde0fe, type: 3}
